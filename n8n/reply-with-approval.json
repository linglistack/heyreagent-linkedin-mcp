    {
      "parameters": {
        "promptType": "define",
        "text": "=Person: {{ $('Loop over people').first().json.participantName }}\nTheir headline: {{ $('Loop over people').first().json.headline }}\nThey have been waiting {{ $('Loop over people').first().json.waitingDays }} days.\nTheir last message: {{ $('Loop over people').first().json.lastMessage }}\n\nThe conversation so far, as LinkedIn returned it (JSON):\n{{ JSON.stringify($json.result.messages || []).slice(0, 6000) }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You draft a reply to a LinkedIn message. The owner of the account reads your draft and decides whether it is sent.\n\nAbout the owner: {{ $('Settings').first().json.aboutYou }}\nHow the owner writes: {{ $('Settings').first().json.yourVoice }}\n\nAnswer what the person actually wrote. At most 80 words. Start with their first name. No hashtags, and no emoji unless they used one. Never make up a fact, a price, a date or a link: when the answer needs one you were not given, ask one short question instead. Write in the language of their last message. Output the message text only."
            }
          ]
        }
      },
